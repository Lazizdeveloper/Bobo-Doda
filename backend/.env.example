# ── Bobo&Doda backend — muhit o'zgaruvchilari ─────────────────────────────
# Nusxa ko'chiring: cp .env.example .env
# App boot BO'LMAYDI agar biror MAJBURIY (required) qiymat yo'q bo'lsa
# (`src/config/env.schema.ts` — Zod validatsiyasi).

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
# A3 — process va DB vaqti UTC. Boshqa qiymat QO'YMANG (timestamptz + UTC).
TZ=UTC
PORT=4000
# pino log darajasi: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Swagger /docs — production'da ataylab yoqilmaydi (SWAGGER_ENABLED=false)
SWAGGER_ENABLED=true
# Frontend'ning CORS origin'i (vergul bilan bir nechta)
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL (MAJBURIY) — A4: ikki rol, ikki URL ──────────────────────
# DATABASE_URL           → `bobododa_app`      — runtime PrismaClient (kam
#                          huquq: audit_logs/outbox_events ga UPDATE/DELETE yo'q)
# DATABASE_MIGRATION_URL → `bobododa_migrator` — faqat `prisma migrate deploy`
#                          (DDL, CREATE EXTENSION, GRANT). schema `directUrl`.
# Rollarni yaratish: prisma/sql/roles.sql (docker init o'zi qiladi).
DATABASE_URL=postgresql://bobododa_app:app@localhost:5432/bobododa?schema=public
DATABASE_MIGRATION_URL=postgresql://bobododa_migrator:migrator@localhost:5432/bobododa?schema=public
# F1 — boot paytida current_user/append-only/kengaytmalarni tekshiradi,
# yiqilsa ilova ko'tarilmaydi. "off" FAQAT dev/test — production'da Zod
# uni rad etadi (fail closed). Qoldiring: on
DB_ROLE_ASSERTION=on
# T1 — F1 shu rol nomi bilan solishtiradi. Ba'zi managed Postgres
# provayderlari rol nomiga cheklov qo'yadi (prefiks/uzunlik) — shunday bo'lsa
# shu yerni VA prisma/sql/roles.sql bootstrap chaqiruvini (-v app_role=...)
# o'zgartiring, migratsiyaga tegmang (u DB darajasidagi GUC'dan o'qiydi).
DB_APP_ROLE=bobododa_app

# ── Redis (MAJBURIY) — cache + BullMQ ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO (Bosqich 2+ da majburiy bo'ladi) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bobododa
S3_SECRET_KEY=bobododa-secret
S3_BUCKET_UPLOADS=bobododa-uploads
# KYC hujjatlari ALOHIDA bucket — public access butunlay yopiq
S3_BUCKET_KYC=bobododa-kyc

# ── Auth (Bosqich 2 da majburiy bo'ladi — kamida 32 belgi) ──────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── To'lov gateway'lari (Bosqich 5) ─────────────────────────────────────
# NODE_ENV=production bo'lsa bularni yozmasdan boot BO'LMAYDI (fail closed)
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=

# ── Telegram support (Bosqich 6) ───────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SUPPORT_CHAT_ID=
