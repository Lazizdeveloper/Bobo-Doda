enum StaffPermission {
  DASHBOARD
  USERS
  SERVICES
  JOBS
  ORDERS
  KYC
  DISPUTES
  PAYMENTS
  REPORTS
  APPEALS
  REVIEWS
  SUPPORT
  CATEGORIES
  SETTINGS
