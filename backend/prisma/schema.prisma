  SELLER
  BUYER
}

/// Admin/operator roli — marketplace `Role` dan ATAYLAB ajratilgan (ADR-04).
enum StaffRole {
  SUPER_ADMIN
  OPERATIONS
  FINANCE
  SUPPORT
  TRUST_SAFETY
  KYC_REVIEWER
  ADMIN
}

/// Admin panel huquqlari (RBAC). Har endpoint aniq bittasini talab qiladi;
