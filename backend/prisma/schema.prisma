// ─────────────────────────────────────────────────────────────────────────────
// Bobo&Doda backend — Prisma schema
//
// Bosqich 1: POYDEVOR (identity + auth token infra + cross-cutting).
// Bosqich 2: AUTH — telefon+OTP (`OtpCode`), refresh rotatsiya/reuse-detection
// uchun `RefreshToken.activeRole`, `User.passwordHash` nullable (parol yo'q).
// Bosqich 3: USER/PROFILE/SELLER ACTIVATION/MARKETPLACE — `User.status`
// (moderatsiya) + `sellerStatus` (layoqatdan mustaqil faollik), `SellerApplication`,
// `Category`, `Service` (moderatsiya state machine bilan).
// Bosqich 4: CONTRACT/ORDER/MILESTONE — `Contract` (ACTIVE Service'dan,
// to'liq iqtisodiy snapshot bilan), `Milestone` + ish tarixi
// (`MilestoneSubmission`/`MilestoneRevisionRequest`). TO'LOV/LEDGER/ESCROW
// HALI YO'Q — keyingi bosqich.
// Bosqich 5: PAYMENT DOMAIN — `Payment` (provider-agnostik, faqat
// ACTIVE Contract uchun — bo'lim 1: docs'dagi "to'lovdan keyin ACTIVE"
// modeli Phase 4'ning allaqachon ishlab chiqarilgan state machine'i bilan
// mos kelmaydi, shuning uchun to'lov ATAYLAB Contract lifecycle'dan
// mustaqil, alohida domen sifatida qo'shildi — `ContractStatus`ga `PAID`
// QO'SHILMADI). `PaymentProviderEvent` — webhook qabul qilish/dedup
// jurnali (append-only).
// Bosqich 6: DOUBLE-ENTRY LEDGER — `LedgerAccount`/`LedgerTransaction`/
// `LedgerEntry` (`docs/03-schema-review.md` B8 — signed yagona `amount`,
// debit/credit ikki ustun EMAS: docs buni ATAYLAB rad etgan, "xato
// manbai"). `Transaction` docs nomi EMAS — Prisma `$transaction`/
// `TransactionClient` bilan chalkashmasin deb `LedgerTransaction`ga
// aniqlashtirilgan (yagona ataylab qilingan nom farqi). Ikki hodisa post
// qiladi: `PAYMENT_FUNDING` (Payment SUCCEEDED) va `CONTRACT_SETTLEMENT`
// (Contract COMPLETED — MILESTONE darajasida EMAS, docs original
// eskizidan farqli: bizda bitta to'liq Payment + bitta yakuniy COMPLETED
// hodisasi bor). REFUND/PAYOUT/DISPUTE HALI YO'Q — keyingi bosqich.
// Qolgan domen modellari (Job, Ledger, Dispute …) o'z bosqichlarida
// qo'shiladi — to'liq loyiha `docs/01-data-model.md` da.
//
// Qoidalar (`docs/02-decisions.md`):
//  • Enum'lar — inglizcha UPPER_SNAKE (ADR-02).
//  • Pul — BigInt tiyin (ADR-01)  → Bosqich 4.
//  • `version Int` — holatga ta'sir qiladigan har modelda (optimistic lock).
//  • Migratsiya faqat `prisma migrate` — qo'lda SQL / `db push` YO'Q.
//  • Birlamchi kalitlar — UUIDv7 (A1). Prisma `@default(uuid())` (v4) YO'Q;
//    ID `src/common/id/id.factory.ts` (`newId()` / `IdFactory`) da yasaladi,
//    service qatlami `data: { id: ids.next(), ... }` beradi. PG16 da native
//    `uuidv7()` yo'q — generatsiya ilova darajasida.
//  • Vaqt — hamma joyda `DateTime @db.Timestamptz(6)` (A3). `timestamp` YO'Q.
//  • DB rollari (A4): `url` = `bobododa_app` (runtime, kam huquq),
//    `directUrl` = `bobododa_migrator` (DDL/kengaytma/GRANT — `prisma migrate`).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime — kam huquqli `bobododa_app` roli (append-only jadvallarga
  // UPDATE/DELETE yo'q, DB darajasida majburlangan).
  url       = env("DATABASE_URL")
  // `prisma migrate` / `db pull` — `bobododa_migrator` roli (DDL, CREATE
  // EXTENSION, GRANT). PrismaClient buni ISHLATMAYDI.
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

/// Marketplace roli. Bitta User bir vaqtda ham SELLER, ham BUYER bo'la oladi
/// (ADR-04). Faol rol JWT ichidagi `activeRole` da — bu yerda emas.
