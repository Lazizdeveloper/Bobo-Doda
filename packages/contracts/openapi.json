{
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Bobo&Doda API",
    "description": "Markaziy Osiyo freelance marketplace — milestone escrow, double-entry ledger. Frontend `lib/api` chegarasini qoplaydi.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 42
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "db": {
            "type": "boolean",
            "example": true
          },
          "redis": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "status",
          "db",
          "redis"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION",
            "description": "Taksonomiya kodi (`error-codes.ts`). Frontend shu bo’yicha matn tanlaydi."
          },
          "message": {
            "type": "string",
            "example": "Validatsiya muvaffaqiyatsiz",
            "description": "Log/debug uchun — foydalanuvchiga ko’rsatilmaydi."
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "phone": "Raqam band"
            },
            "description": "Maydon-darajali validatsiya — to’g’ridan-to’g’ri forma maydonlariga."
          },
          "requestId": {
            "type": "string",
            "example": "3f9a1c2e-...",
            "description": "So’rov identifikatori — log bilan bog’lash uchun (`x-request-id`)."
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
