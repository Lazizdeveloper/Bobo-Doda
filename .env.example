# Sayt ichidagi Yordam (Support) modali → /api/support → Telegram Bot API.
# Bu ikkisi QO'YILMASA, har bir support so'rovi 500 (SERVER_MISCONFIGURED)
# bilan yiqiladi va foydalanuvchi xato ekranini ko'radi.
# Token faqat server tomonda o'qiladi, brauzer bundle'iga TUSHMAYDI.
# DIQQAT: bu OTP KANALI EMAS — foydalanuvchi OTP kodi HECH QACHON shu orqali
# yuborilmaydi. Barcha foydalanuvchi OTP yetkazilishi FAQAT SMS orqali
# (backend `SMS_PROVIDER`, `backend/.env.example`ga qarang); email va
# Telegram OTP kanali emas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Backend API manzili.
#
# BO'SH QOLDIRILSA: ilova brauzer ichidagi mock adapter bilan ishlaydi
# (`lib/mock-api`, localStorage) — hozirgi holat.
#
# BERILGANDA: `lib/api/client.ts` va `lib/api/admin.ts` shu manzilga
# HTTP so'rov yuboradi VA bu origin avtomatik ravishda CSP `connect-src`
# ga qo'shiladi (`csp.config.mjs`), shu bilan birga `wss://` varianti ham
# (real-time chat/bildirishnomalar uchun).
#
# ⚠️ BU O'ZGARUVCHI BUILD VAQTIDA BERILISHI SHART.
# Next.js `headers()` natijasini build paytida `routes-manifest.json` ga
# yozadi — `next start` uni qayta hisoblamaydi. Ya'ni env'ni faqat runtime'ga
# qo'ysangiz, CSP eski holicha (`connect-src 'self'`) qoladi va API
# so'rovlari bloklanadi. Netlify'da build env'i shu talabni qondiradi;
# qo'lda deploy qilsangiz — `NEXT_PUBLIC_API_URL=... npm run build`.
#
# ⚠️ Bundan tashqari `netlify.toml` dagi `connect-src` ni ham QO'LDA
# yangilash kerak — toml env o'zgaruvchisini o'qiy olmaydi.
# `npm run check:csp` ikkisining mosligini tekshiradi.
#
# NEXT_PUBLIC_ prefiksi — qiymat brauzer bundle'iga tushadi. Bu yerga
# HECH QACHON maxfiy kalit yozilmasin, faqat ochiq manzil.
NEXT_PUBLIC_API_URL=

# ─────────────────────────────────────────────────────────────────────────
# Namoyish (demo) ish maydoni — FAQAT prezentatsiya uchun.
#
# "1" bo'lsa, HAR BIR yangi ro'yxatdan o'tgan hisob darhol tayyor ish
# maydoni bilan to'ldiriladi: 3 ta shartnoma, 7 ta bosqich, 2 ta bank
# kartasi, 3 ta xizmat va 4.9 reyting · 12 sharh · "top mutaxassis"
# belgisi bilan to'ldirilgan profil.
#
# ⚠️ REAL FOYDALANUVCHILAR UCHUN O'CHIQ QOLSIN (bo'sh yoki "0").
# Aks holda odam ro'yxatdan o'tgan zahoti o'zi ishlamagan ~9,5 mln so'm
# "yechish mumkin" summasini, o'zi bog'lamagan kartalarni va o'zi
# olmagan ishonch belgisini ko'radi — escrow platformasida bu ishonchni
# birinchi daqiqada buzadi.
#
# Backend ulanganda bu mexanizm butunlay olib tashlanadi.
NEXT_PUBLIC_DEMO_WORKSPACE=
