{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "//": "include ataylab aniq papkalar bilan cheklangan. Ilgari \"**/*.tsx\" edi — u holda papka ichiga tushib qolgan loyihaning eski/zaxira nusxasi ham tekshirilib, build'ni yiqitardi.",
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
